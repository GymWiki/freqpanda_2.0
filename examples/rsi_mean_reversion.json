{
  "name": "rsi_mean_reversion",
  "description": "Long when price is oversold (RSI below 30) and touching the lower Bollinger Band, exit when RSI recovers above 70 or on risk limits.",
  "timeframe": "1h",
  "indicators": [
    {
      "name": "rsi",
      "alias": "rsi14",
      "params": {
        "period": { "default": 14, "min": 7, "max": 21, "step": 1 }
      }
    },
    {
      "name": "bbands",
      "alias": "bb",
      "params": {
        "period": { "default": 20, "min": 10, "max": 40, "step": 1 },
        "std_dev": { "default": 2, "min": 1.5, "max": 3, "step": 0.1 }
      }
    }
  ],
  "entry_conditions": {
    "type": "logical",
    "op": "and",
    "conditions": [
      { "type": "comparison", "left": "rsi14", "op": "lt", "right": 30 },
      { "type": "comparison", "left": "close", "op": "lte", "right": "bb_lower" }
    ]
  },
  "exit_conditions": {
    "type": "comparison",
    "left": "rsi14",
    "op": "gt",
    "right": 70
  },
  "risk_management": {
    "stop_loss_pct": 0.03,
    "take_profit_pct": 0.05
  }
}
