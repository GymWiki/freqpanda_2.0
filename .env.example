# Copy to .env and fill in. Used by both the api and worker services
# (docker-compose.yml's `env_file: .env`) and by scripts run outside Docker
# (phase 2's pipeline, phase 4's example script, ...).

# Supabase Postgres connection string (Project Settings -> Database ->
# Connection string -> URI). Same variable phase 2 uses.
SUPABASE_DB_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Comma-separated list of accepted API keys. Generate with e.g.
# `openssl rand -hex 32`. Rotate by adding the new key, redeploying, then
# removing the old one -- no downtime, since both are valid while both are listed.
API_KEYS=change-me-to-a-long-random-value

# Set automatically to redis://redis:6379/0 by docker-compose.yml for the
# api/worker services; only needed here if running the API or a worker
# outside Docker (e.g. locally against docker-compose's exposed Redis, if
# you add a `ports:` mapping for it -- not exposed by default).
REDIS_URL=redis://localhost:6379/0

# Must match between the API (which enqueues) and every worker (which
# listens) -- see docker-compose.yml's worker command.
JOB_QUEUE_NAME=freqpanda

# Default CCXT exchange id for phase-2 pipeline runs.
DEFAULT_EXCHANGE_ID=binance

# Per-job hard timeout (RQ kills a job that runs longer than this).
JOB_TIMEOUT_SECONDS=1800

# --- Phase 7: execution engine (freqpanda_execution) ---

# Fernet key encrypting exchange API credentials at rest -- generate once
# with:
#   python -c "from freqpanda_execution.crypto import generate_master_key; print(generate_master_key())"
# and set the SAME value in the environment of the API (which stores
# credentials) and the supervisor/bot processes (which decrypt them).
# Losing this key makes every stored credential permanently undecryptable
# -- see freqpanda_execution/README.md before rotating or losing it.
EXECUTION_MASTER_KEY=change-me-generate-with-freqpanda_execution.crypto.generate_master_key

# How often (seconds) the supervisor reconciles bots.desired_status against
# the subprocesses it actually has running.
SUPERVISOR_POLL_INTERVAL_SECONDS=5

# How often (seconds) an idle bot still writes bot_state.last_heartbeat_at,
# so "quietly waiting for the next candle" can be told apart from "the
# process died" from the outside.
HEARTBEAT_INTERVAL_SECONDS=15

# Polling fallback interval for exchange/timeframe combinations without
# websocket OHLCV support.
FEED_POLL_INTERVAL_SECONDS=5

# Crash-loop protection: the supervisor stops restarting a bot (and marks
# it 'error') after this many crashes within CRASH_LOOP_WINDOW_SECONDS.
MAX_RESTARTS_IN_WINDOW=3
CRASH_LOOP_WINDOW_SECONDS=300
